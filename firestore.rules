rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function sharedAccount() {
      return request.auth != null
        && request.auth.uid == 'REPLACE_WITH_YOUR_FIREBASE_AUTH_UID';
    }
    match /qaTrackerV2/main {
      allow read, write: if sharedAccount();
    }
    match /qaTrackerV2/publicSummary {
      allow read: if true;
      allow write: if sharedAccount();
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
